import random
import string

def generate_secure_password(length=12):
    if length < 4:
        raise ValueError("La longitud de la contraseña debe ser al menos 4 para asegurar la inclusión de minúsculas, mayúsculas, dígitos y símbolos.")

    lowercase_chars = string.ascii_lowercase
    uppercase_chars = string.ascii_uppercase
    digit_chars = string.digits
    symbol_chars = string.punctuation
    
    all_chars = lowercase_chars + uppercase_chars + digit_chars + symbol_chars

    password_chars_list = []

    password_chars_list.append(random.choice(lowercase_chars))
    password_chars_list.append(random.choice(uppercase_chars))
    password_chars_list.append(random.choice(digit_chars))
    password_chars_list.append(random.choice(symbol_chars))

    for _ in range(length - 4):
        password_chars_list.append(random.choice(all_chars))

    random.shuffle(password_chars_list)

    return "".join(password_chars_list)